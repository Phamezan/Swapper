{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Swapper",
  "version": "0.2.0",
  "identifier": "com.phamezan.swapper",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Swapper",
        "width": 360,
        "height": 480,
        "minWidth": 360,
        "minHeight": 480,
        "maxWidth": 360,
        "maxHeight": 480,
        "visible": false,
        "decorations": false,
        "shadow": false,
        "resizable": false,
        "skipTaskbar": true,
        "alwaysOnTop": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: http://asset.localhost data:; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "resources": {
      "resources/Deceive.exe": "Deceive.exe",
      "resources/Deceive-LICENSE.txt": "Deceive-LICENSE.txt",
      "resources/Deceive-SOURCE.txt": "Deceive-SOURCE.txt"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
