{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Swapper",
  "version": "0.6.0",
  "identifier": "com.phamezan.swapper",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Swapper",
        "width": 400,
        "height": 640,
        "minWidth": 400,
        "minHeight": 640,
        "maxWidth": 400,
        "maxHeight": 640,
        "visible": false,
        "decorations": false,
        "shadow": false,
        "resizable": false,
        "skipTaskbar": true,
        "alwaysOnTop": true,
        "additionalBrowserArgs": "--disable-features=msWebOOUI,msPdfOOUI,msSmartScreenProtection --disable-gpu"
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: http://asset.localhost data:; style-src 'self' 'unsafe-inline'"
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/Phamezan/Swapper/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDVBNDVGNDI3OTdDNzlFMkIKUldRcm5zZVhKL1JGV2xnZXE1N1hWUzVlR0lYRnVkTDg3ZXkyejNsTktMZzU0bHUzZURQcHZvbU4K",
      "windows": {
        "installMode": "passive"
      }
    },
    "deep-link": {
      "desktop": {
        "schemes": ["swapper"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "resources": {
      "resources/Deceive.exe": "Deceive.exe",
      "resources/Deceive-LICENSE.txt": "Deceive-LICENSE.txt",
      "resources/Deceive-SOURCE.txt": "Deceive-SOURCE.txt",
      "resources/korean-font.fantome": "korean-font.fantome",
      "resources/Korean-Font-CREDITS.txt": "Korean-Font-CREDITS.txt"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
