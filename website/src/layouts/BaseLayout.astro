---
import "../styles/site.css";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Swapper: one-click Riot account switcher for League of Legends",
  description = "Switch between Riot accounts without typing a password. A tray flyout and a Fullsized App League companion for Windows.",
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#08090a" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/swapper.svg" />
    <link rel="preconnect" href="https://ddragon.leagueoflegends.com" />
    <title>{title}</title>
    <script is:inline>document.documentElement.classList.add("js");</script>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <slot />
  </body>
</html>
